# ============================================================
# PrintManager-Native – Umgebungsvariablen
#
# ANLEITUNG:
#   cp .env.example .env
#   Wähle sichere Passwörter und trage sie in .env ein.
#   Die .env-Datei wird NICHT ins Git-Repository eingecheckt.
# ============================================================

# Datenbankname
DB_NAME=printmanager

# Datenbankbenutzer (kein Root!)
DB_USER=erp_user

# Passwort für den Datenbankbenutzer – bitte ändern!
DB_PASS=CHANGE_ME_strong_password

# Root-Passwort für MariaDB – bitte ändern!
DB_ROOT_PASS=CHANGE_ME_root_password
